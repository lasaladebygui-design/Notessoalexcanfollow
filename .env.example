# Copia este archivo como .env y rellena tus valores. Nunca subas .env al repo.

# --- Django -----------------------------------------------------------
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (Supabase Postgres) ---------------------------------
# Deja vacío para usar SQLite local automáticamente.
# Formato: postgres://usuario:password@host:puerto/nombre_bd
# Usa el "Transaction pooler" de Supabase (host aws-0-<region>.pooler.supabase.com,
# puerto 6543, usuario postgres.<project-ref>) -- la conexión directa es
# IPv6-only y no funciona desde muchas redes/Render.
DATABASE_URL=

# --- Google Calendar (OAuth, opcional) ---------------------------------
# Vacías = el botón "Conectar con Google Calendar" no aparece.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Render (se rellena solo en producción) -----------------------------
RENDER_EXTERNAL_HOSTNAME=
